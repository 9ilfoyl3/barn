{
  "name": "barn-desktop",
  "version": "0.1.0",
  "description": "General-purpose local-first personal Agent for everyday office work, built on Pi Agent Core and pi-ai.",
  "author": "Barn",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:mac:dir": "electron-vite build && electron-builder --mac --dir",
    "package:win": "electron-vite build && electron-builder --win",
    "package:win:dir": "electron-vite build && electron-builder --win --dir",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint src tests scripts",
    "docs:check": "tsx scripts/verify-agent-notes.ts",
    "test:e2e": "electron-vite build && playwright test",
    "security:check": "tsx scripts/verify-ipc-security.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "fflate": "^0.8.3",
    "i18next": "^26.5.11",
    "lucide-react": "1.62.0",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.9",
    "streamdown": "^2.7.1",
    "typebox": "1.3.27",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "oxlint": "1.90.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
